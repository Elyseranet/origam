{
  "name": "OrigamAudio",
  "tag": "origam-audio",
  "family": "Audio",
  "label": "Audio",
  "props": [
    {
      "name": "variant",
      "label": "variant",
      "tsType": "\"normal\" | \"compact\" | \"expanded\" | \"minimal\" | undefined",
      "runtimeType": null,
      "required": false,
      "defaultValue": "expanded",
      "hasFactoryDefault": false,
      "options": [
        "normal",
        "compact",
        "expanded",
        "minimal"
      ],
      "control": "select",
      "description": "Visual variant of the audio surface.\n\n- `'expanded'` — full Stemtracks studio strip: 96 px cover,\n                 title / artist / album header, waveform mini\n                 scrubber above the transport row.\n- `'compact'`  — slim transport-only dock: 48 px cover, inline\n                 metadata, no waveform, transport row only.\n\nLegacy `'normal'` / `'minimal'` alias values remain accepted for\nbackward compatibility and resolve to `'expanded'` / `'compact'`.",
      "source": "types"
    },
    {
      "name": "coverPosition",
      "label": "coverPosition",
      "tsType": "\"left\" | \"right\" | undefined",
      "runtimeType": null,
      "required": false,
      "defaultValue": "left",
      "hasFactoryDefault": false,
      "options": [
        "left",
        "right"
      ],
      "control": "select",
      "description": "Side of the surface where the album cover is painted. The\ncontroller column sits on the opposite side. Swap to keep the\ncover next to the page edge (e.g. against a left sidebar).",
      "source": "types"
    },
    {
      "name": "src",
      "label": "src",
      "tsType": "string | IAudioSource | IAudioSource[]",
      "runtimeType": [
        "String",
        "Object",
        "Array"
      ],
      "required": true,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Media URL — either a single string for `<audio src>`, an\n`IAudioSource` object (`{ src, type }`), or an array of sources\nfor codec fallback. The browser walks the array top-down and\npicks the first source whose `type` it can decode.",
      "source": "types"
    },
    {
      "name": "tracks",
      "label": "tracks",
      "tsType": "IVideoTrack[] | undefined",
      "runtimeType": "Array",
      "required": false,
      "hasFactoryDefault": true,
      "control": "json",
      "description": "Optional captions / chapters tracks attached to the `<audio>`.\nReuses the video track shape (kind / src / srclang / label /\ndefault) so consumers learn the API once.",
      "source": "types"
    },
    {
      "name": "title",
      "label": "title",
      "tsType": "string | undefined",
      "runtimeType": "String",
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Optional title shown above the controls (e.g. `\"Podcast Episode 42\"`).",
      "source": "types"
    },
    {
      "name": "artist",
      "label": "artist",
      "tsType": "string | undefined",
      "runtimeType": "String",
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Optional artist / author shown next to the title.",
      "source": "types"
    },
    {
      "name": "album",
      "label": "album",
      "tsType": "string | undefined",
      "runtimeType": "String",
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Optional album name shown below the artist (ported from\n`ISoundMetadata.album`). Renders only when set.",
      "source": "types"
    },
    {
      "name": "cover",
      "label": "cover",
      "tsType": "string | ISrcObject | undefined",
      "runtimeType": [
        "String",
        "Object"
      ],
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Optional cover image shown next to the title. Accepts a URL\nstring or an `ISrcObject` for srcset / lazy-src support.",
      "source": "types"
    },
    {
      "name": "waveform",
      "label": "waveform",
      "tsType": "boolean | \"auto\" | undefined",
      "runtimeType": [
        "Boolean",
        "String"
      ],
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Display the computed waveform above the controls. Pass `true`\nto force the computation (when supported); pass `'auto'` to\nactivate it only when the browser supports `OfflineAudioContext`.\nSSR + jsdom fall through to `false`.\n\nThe decoder lives in `useWaveform` — fetch + decode through\n`OfflineAudioContext` + downsample channel 0 to 200 peaks.",
      "source": "types"
    },
    {
      "name": "waveformColor",
      "label": "waveformColor",
      "tsType": "string | undefined",
      "runtimeType": "String",
      "required": false,
      "defaultValue": "currentColor",
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Stroke colour for the *played* portion of the waveform bars.\nDefault `'currentColor'` so the waveform inherits the\ntypographic theme. Override via the prop OR via\n`--origam-audio__waveform---color-played` directly on the wrapper.",
      "source": "types"
    },
    {
      "name": "autoplay",
      "label": "autoplay",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Starts playback as soon as `loadedmetadata` fires. Most\nbrowsers require `muted=true` alongside `autoplay`; the\ncomponent forces `muted=true` when the consumer asks for\nautoplay without an explicit `muted` value.\n\n**Accessibility:** `autoplay` is suppressed when the user has\nrequested reduced motion.",
      "source": "types"
    },
    {
      "name": "muted",
      "label": "muted",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Starts the player muted.",
      "source": "types"
    },
    {
      "name": "loop",
      "label": "loop",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Legacy loop flag. When `true` is mapped to `loopMode='one'` at\nruntime so a v0.x consumer keeps the \"loop this track forever\"\nbehaviour without source change. Prefer `loopMode` for new code.",
      "source": "types"
    },
    {
      "name": "loopMode",
      "label": "loopMode",
      "tsType": "\"none\" | \"all\" | \"one\" | undefined",
      "runtimeType": null,
      "required": false,
      "defaultValue": "none",
      "hasFactoryDefault": false,
      "options": [
        "none",
        "all",
        "one"
      ],
      "control": "select",
      "description": "Tri-state loop strategy when a playlist is active. Cycled by the\nloop button in the transport row:\n  - `'none'` → no loop, playback stops after the last track\n  - `'all'`  → loop the playlist, wrap from last to first\n  - `'one'`  → loop the current track on its own `ended`\n\nFor a single-track usage (`src` only, no `playlist`), `'one'`\nkeeps the legacy `loop` behaviour and `'all'` is equivalent to\n`'one'` (there's no next track to wrap to).",
      "source": "types"
    },
    {
      "name": "shuffle",
      "label": "shuffle",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Shuffle the playlist order when navigating with prev / next or\nauto-advancing on track end. The shuffled order is computed\ndeterministically (Fisher-Yates seeded by playlist length) so\nconsumers can re-render predictably; opt out of stability by\ncontrolling the playlist array externally.\n\nHas no visible effect when no `playlist` is provided.",
      "source": "types"
    },
    {
      "name": "playlist",
      "label": "playlist",
      "tsType": "IAudioTrack[] | undefined",
      "runtimeType": "Array",
      "required": false,
      "hasFactoryDefault": false,
      "control": "json",
      "description": "Optional list of tracks to play sequentially. When set, the\n`prev` / `next` transport buttons navigate the list instead of\nskipping 10 s, the cover / metadata strip switches to the active\ntrack, and a clickable list renders below the transport.\n\nMutually informative with the top-level `src` prop: if `src`\nAND `playlist` are both set, `playlist` wins and `src` is\nignored. The active track is `playlist[currentTrackIndex]`.",
      "source": "types"
    },
    {
      "name": "currentTrackIndex",
      "label": "currentTrackIndex",
      "tsType": "number | undefined",
      "runtimeType": "Number",
      "required": false,
      "defaultValue": 0,
      "hasFactoryDefault": false,
      "control": "number",
      "description": "Index of the currently-active track in the `playlist`. Supports\n`v-model:currentTrackIndex` for two-way binding (parent stays the\nsource of truth for which track is playing).",
      "source": "types"
    },
    {
      "name": "preload",
      "label": "preload",
      "tsType": "\"none\" | \"metadata\" | \"auto\" | undefined",
      "runtimeType": "String",
      "required": false,
      "defaultValue": "metadata",
      "hasFactoryDefault": false,
      "options": [
        "none",
        "metadata",
        "auto"
      ],
      "control": "select",
      "description": "Buffering hint. `'metadata'` (default) loads just enough to\ncompute the duration; `'none'` defers everything until the\nuser presses play; `'auto'` lets the browser pre-buffer.",
      "source": "types"
    },
    {
      "name": "crossorigin",
      "label": "crossorigin",
      "tsType": "string | undefined",
      "runtimeType": "String",
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Mirrors the native `crossorigin` attribute. Required when the\nmedia is served from a CORS-enabled origin and the consumer\nneeds WebAudio access to the decoded samples.",
      "source": "types"
    },
    {
      "name": "controls",
      "label": "controls",
      "tsType": "TAudioControls | undefined",
      "runtimeType": null,
      "required": false,
      "defaultValue": "custom",
      "hasFactoryDefault": false,
      "options": [
        "custom",
        "native"
      ],
      "control": "select",
      "description": "Which control surface to render. `'custom'` paints the\n`<OrigamMediaController>` shell; `'native'` exposes the\nbrowser's built-in `controls` attribute on the `<audio>`.",
      "source": "alias"
    },
    {
      "name": "playbackRates",
      "label": "playbackRates",
      "tsType": "readonly number[] | undefined",
      "runtimeType": "Array",
      "required": false,
      "hasFactoryDefault": true,
      "control": "json",
      "description": "Available playback rates exposed via the config menu.",
      "source": "types"
    },
    {
      "name": "playbackRate",
      "label": "playbackRate",
      "tsType": "number | undefined",
      "runtimeType": "Number",
      "required": false,
      "defaultValue": 1,
      "hasFactoryDefault": false,
      "control": "number",
      "description": "Initial playback rate. The runtime value is exposed via the\n`update:playbackRate` emit.",
      "source": "types"
    },
    {
      "name": "allowRemotePlayback",
      "label": "allowRemotePlayback",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Enable the cast / AirPlay button (Remote Playback API). The\nbutton only renders when this flag is true AND at least one\ncast-capable device is detected.",
      "source": "types"
    },
    {
      "name": "downloadable",
      "label": "downloadable",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Adds a \"Download\" row to the cog menu that lets the listener\ndownload the currently-playing audio file.",
      "source": "types"
    },
    {
      "name": "downloadFilename",
      "label": "downloadFilename",
      "tsType": "string | undefined",
      "runtimeType": "String",
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Override the downloaded file name. Defaults to the trailing\nsegment of the source URL.",
