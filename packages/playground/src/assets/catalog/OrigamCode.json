{
  "name": "OrigamCode",
  "tag": "origam-code",
  "family": "Code",
  "label": "Code",
  "props": [
    {
      "name": "code",
      "label": "code",
      "tsType": "string | undefined",
      "runtimeType": "String",
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "The code to highlight. When omitted, the default slot is used as the\nsource — useful for multi-line snippets that are nicer to read in\nthe template than as a JS string literal. When both are provided,\nthe prop wins.",
      "source": "types"
    },
    {
      "name": "lang",
      "label": "lang",
      "tsType": "TCodeLangOpen | undefined",
      "runtimeType": null,
      "required": false,
      "defaultValue": "plaintext",
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Language grammar to apply. Autocompletes the 14 values of\n`SUPPORTED_LANGS` but accepts any string (#1180). Without a custom\n`code.highlighter`, a value outside `SUPPORTED_LANGS` and outside\n`createOrigam({ code: { langs } })` falls back to `plaintext` (one-shot\nconsole warning). With a custom `code.highlighter`, the value is handed\nto it as-is; if it cannot tokenise it, the block falls back to\n`plaintext` (dev-only warning).",
      "source": "types"
    },
    {
      "name": "lineNumbers",
      "label": "lineNumbers",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Show a left gutter with line numbers. Pure CSS — uses a CSS counter\nincremented per `.origam-code__row`, no JS layout work.",
      "source": "types"
    },
    {
      "name": "highlightLines",
      "label": "highlightLines",
      "tsType": "string | number[] | null | undefined",
      "runtimeType": [
        "Array",
        "String"
      ],
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Lines to highlight. Accepts either a pre-computed array of 1-based\nline numbers (`[2, 5, 6, 7]`) or a comma/range string (`'2,5-7'`)\nthat the component parses via `parseHighlightLines()`. `null` /\nempty disables the feature.",
      "source": "types"
    },
    {
      "name": "copyable",
      "label": "copyable",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": true,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Show the copy-to-clipboard button in the top-right corner. Defaults\nto `true` — most code blocks benefit from it.",
      "source": "types"
    },
    {
      "name": "format",
      "label": "format",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Auto-format the code before highlighting. Reserved for v3 — prettier\nis intentionally NOT bundled at runtime to keep the tarball small.\nCurrently a no-op; passing `true` warns once in dev and pre-formats\nvia a best-effort whitespace trim only.",
      "source": "types"
    },
    {
      "name": "wrap",
      "label": "wrap",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Wrap long lines instead of scrolling horizontally. Off by default so\nthe visual column matches the source file.",
      "source": "types"
    },
    {
      "name": "filename",
      "label": "filename",
      "tsType": "string | undefined",
      "runtimeType": "String",
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Optional filename rendered in the header bar (e.g. `'App.vue'`).\nWhen provided AND `copyable` is true, the header also hosts the copy\nbutton; otherwise the copy button is absolutely positioned in the\ntop-right corner of the code surface.",
      "source": "types"
    },
    {
      "name": "compact",
      "label": "compact",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Render the block as a single-line **pill** instead of a multi-line\nsurface — ideal for a copyable install command (`npm install origam`).\nIn compact mode the header, filename and line-numbers are suppressed,\nvertical padding shrinks to one line, the surface keeps its themed\ntokens, and the copy control collapses to a small icon button anchored\ninline at the end of the row (not a floating text \"Copy\"). The `<figure>\n<pre><code>` semantics are preserved.",
      "source": "types"
    },
    {
      "name": "prompt",
      "label": "prompt",
      "tsType": "string | undefined",
      "runtimeType": "String",
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Decorative prompt prefix rendered BEFORE the code (e.g. `'$'` for a\nshell command). Purely visual: it is NOT part of the highlighted code\nand is NEVER included in the clipboard copy (only `code` is copied).\nMost useful paired with `compact` for an install-command pill.",
      "source": "types"
    },
