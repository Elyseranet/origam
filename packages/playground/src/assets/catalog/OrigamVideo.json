{
  "name": "OrigamVideo",
  "tag": "origam-video",
  "family": "Video",
  "label": "Video",
  "props": [
    {
      "name": "src",
      "label": "src",
      "tsType": "string | IVideoSource[]",
      "runtimeType": [
        "String",
        "Array"
      ],
      "required": true,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Media URL — either a single string for `<video src>`, or an array\nof `<source>` descriptors when multiple formats are provided. The\nbrowser walks the list top-down and picks the first source whose\n`type` it can decode; pass the most preferred codec first.",
      "source": "types"
    },
    {
      "name": "poster",
      "label": "poster",
      "tsType": "string | undefined",
      "runtimeType": "String",
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Image rendered before playback starts. Maps to the native\n`poster` attribute when the `#poster` slot is not used.",
      "source": "types"
    },
    {
      "name": "tracks",
      "label": "tracks",
      "tsType": "IVideoTrack[] | undefined",
      "runtimeType": "Array",
      "required": false,
      "hasFactoryDefault": true,
      "control": "json",
      "description": "Captions / subtitles / chapter tracks attached to the player.\nEmpty array (the default) renders no `<track>` element.",
      "source": "types"
    },
    {
      "name": "autoplay",
      "label": "autoplay",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Starts playback as soon as `loadedmetadata` fires. Browsers\nusually require `muted` to be true alongside `autoplay`; the\ncomponent forces `muted=true` when the user passes `autoplay`\nwithout an explicit `muted` value.\n\n**Accessibility:** `autoplay` is suppressed when the user has\nrequested reduced motion (`prefers-reduced-motion: reduce`).",
      "source": "types"
    },
    {
      "name": "muted",
      "label": "muted",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Starts the player muted. Setting `muted=true` together with\n`autoplay=true` is required for most browsers to allow\nunattended playback.",
      "source": "types"
    },
    {
      "name": "loop",
      "label": "loop",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Loops playback. The player restarts at `0` when `ended` fires.",
      "source": "types"
    },
    {
      "name": "controls",
      "label": "controls",
      "tsType": "\"none\" | \"custom\" | \"native\" | undefined",
      "runtimeType": null,
      "required": false,
      "defaultValue": "custom",
      "hasFactoryDefault": false,
      "options": [
        "none",
        "custom",
        "native"
      ],
      "control": "select",
      "description": "Which control surface to render. `'custom'` paints the in-house\ntoolbar; `'native'` exposes the browser's built-in `controls`\nattribute; `'none'` renders neither so the consumer can drive\nplayback through the `#controls` slot or programmatically.",
      "source": "types"
    },
    {
      "name": "playsInline",
      "label": "playsInline",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": true,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Mirrors the native `playsinline` attribute. Required on iOS to\nkeep the player inside the page (otherwise iOS hijacks the\nplayback into the system video viewer). Defaults to `true`\nbecause that's the in-page UX we want 99 % of the time.",
      "source": "types"
    },
    {
      "name": "preload",
      "label": "preload",
      "tsType": "\"none\" | \"metadata\" | \"auto\" | undefined",
      "runtimeType": "String",
      "required": false,
      "defaultValue": "metadata",
      "hasFactoryDefault": false,
      "options": [
        "none",
        "metadata",
        "auto"
      ],
      "control": "select",
      "description": "Buffering hint. `'metadata'` (default) loads just enough to\ncompute the duration; `'none'` defers everything until the user\npresses play; `'auto'` lets the browser pre-buffer as much as it\nwants.",
      "source": "types"
    },
    {
      "name": "aspectRatio",
      "label": "aspectRatio",
      "tsType": "string | undefined",
      "runtimeType": "String",
      "required": false,
      "defaultValue": "16/9",
      "hasFactoryDefault": false,
      "control": "text",
      "description": "CSS `aspect-ratio` value applied to the wrapper. Accepts the\npresets (`'16/9'`, `'4/3'`, `'1/1'`, `'21/9'`, `'9/16'`) or any\nraw value (`'2 / 1'`, `'1.85'`, …). The wrapper enforces the\nratio via `aspect-ratio` so the player never re-flows the page\nafter metadata loads.",
      "source": "types"
    },
    {
      "name": "crossorigin",
      "label": "crossorigin",
      "tsType": "TCrossOrigin | undefined",
      "runtimeType": null,
      "required": false,
      "hasFactoryDefault": false,
      "options": [
        "",
        "anonymous",
        "use-credentials"
      ],
      "control": "select",
      "description": "Mirrors the native `crossorigin` attribute. Required when the\nmedia or its tracks are served from a CORS-enabled origin and\nthe consumer needs canvas / WebAudio access to the decoded\nframes. Affects how cookies are sent on the request.",
      "source": "alias"
    },
    {
      "name": "disablePictureInPicture",
      "label": "disablePictureInPicture",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Disables the picture-in-picture button (and the matching\nkeyboard shortcut). Useful for content where PIP would defeat\nthe experience (e.g. a synced multi-player layout).",
      "source": "types"
    },
    {
      "name": "skipSeconds",
      "label": "skipSeconds",
      "tsType": "number | undefined",
      "runtimeType": "Number",
      "required": false,
      "defaultValue": 30,
      "hasFactoryDefault": false,
      "control": "number",
      "description": "Seconds skipped by the ±skip buttons and by the double-tap\ngesture on touch devices. Pass `0` to hide the skip buttons.",
      "source": "types"
    },
    {
      "name": "showCenterControls",
      "label": "showCenterControls",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": true,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Show the centered ±skip buttons + play/pause overlay on hover\n(and always while paused). When `false`, only the bottom\ntoolbar handles play/pause.",
      "source": "types"
    },
    {
      "name": "playbackRates",
      "label": "playbackRates",
      "tsType": "readonly number[] | undefined",
      "runtimeType": "Array",
      "required": false,
      "hasFactoryDefault": true,
      "control": "json",
      "description": "Available playback rates exposed via the config menu.",
      "source": "types"
    },
    {
      "name": "playbackRate",
      "label": "playbackRate",
      "tsType": "number | undefined",
      "runtimeType": "Number",
      "required": false,
      "defaultValue": 1,
      "hasFactoryDefault": false,
      "control": "number",
      "description": "Initial playback rate. The runtime value is exposed via the\n`update:playbackRate` emit and the `playbackRate` scoped-slot\nbinding.",
      "source": "types"
    },
    {
      "name": "inset",
      "label": "inset",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": true,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Layout mode for the bottom toolbar :\n  - `true` — controls overlaid on the video bottom edge,\n    auto-hide while playing once the cursor leaves.\n  - `false` — controls always painted, no auto-hide.",
      "source": "types"
    },
    {
      "name": "allowRemotePlayback",
      "label": "allowRemotePlayback",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": true,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Enable the cast / AirPlay button (Remote Playback API). The\nbutton only renders when the browser exposes the API AND at\nleast one cast-capable device is detected. No 3rd-party plugin.",
      "source": "types"
    },
    {
      "name": "doubleTapToSkip",
      "label": "doubleTapToSkip",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": true,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Enable double-tap gestures on touch devices: tap-tap on the\nleft half = skip backward by `skipSeconds`, on the right half =\nskip forward.",
      "source": "types"
    },
    {
      "name": "downloadable",
      "label": "downloadable",
      "tsType": "boolean | undefined",
      "runtimeType": "Boolean",
      "required": false,
      "defaultValue": false,
      "hasFactoryDefault": false,
      "control": "switch",
      "description": "Adds a \"Download\" row to the settings (cog) menu that lets the\nviewer download the currently-playing video file. The browser's\nstandard download dialog opens — no analytics, no XHR, no server\ncall. Works on every modern browser (uses the native `download`\nattribute on a hidden `<a>` element).\n\nSet to `false` (default) to hide the row, e.g. for licensed\ncontent that must stay streamed.",
      "source": "types"
    },
    {
      "name": "downloadFilename",
      "label": "downloadFilename",
      "tsType": "string | undefined",
      "runtimeType": "String",
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Override the downloaded file name. Defaults to the trailing\nsegment of the source URL. Useful when the URL is opaque\n(e.g. signed-S3 with a hash basename) and you want the file\nto land in the user's Downloads folder with a clean name.",
      "source": "types"
    },
