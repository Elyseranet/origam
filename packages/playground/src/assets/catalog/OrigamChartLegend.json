{
  "name": "OrigamChartLegend",
  "tag": "origam-chart-legend",
  "family": "Chart",
  "label": "ChartLegend",
  "props": [
    {
      "name": "items",
      "label": "items",
      "tsType": "IChartLegendItem[]",
      "runtimeType": "Array",
      "required": true,
      "hasFactoryDefault": false,
      "control": "json",
