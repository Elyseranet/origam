      "source": "types"
    },
    {
      "name": "position",
      "label": "position",
      "tsType": "TDirectionBoth | undefined",
      "runtimeType": null,
      "required": false,
      "defaultValue": "bottom",
      "hasFactoryDefault": false,
      "options": [
        "top",
        "bottom",
        "left",
        "right"
      ],
      "control": "select",
      "description": "Anchor of the legend block. Drives the wrapping behaviour\n(`row` on top/bottom, `column` on left/right).",
      "source": "alias"
    }
  ],
  "events": [
    {
      "name": "legend-click",
      "label": "legend-click",
      "payloadType": "[series: IChartSeries, index: number]",
      "source": "types"
    },
    {
      "name": "series-toggle",
      "label": "series-toggle",
      "payloadType": "[series: IChartSeries, visible: boolean]",
      "source": "types"
    }
  ],
  "slots": [
    {
      "name": "legend-item",
      "label": "legend-item",
      "slotPropsType": "{ series: IChartSeries; index: number; visible: boolean; }",
