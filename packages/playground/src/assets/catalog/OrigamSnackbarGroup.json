      "hasFactoryDefault": false,
      "control": "text",
      "description": "Identifier of the stack this container renders. Pair with\n`useSnackbarGroup({ id })` to spawn items into the same stack.\nMultiple stacks can coexist (e.g. a global one + a per-region\none) — each one is keyed independently.",
      "source": "types"
    },
    {
      "name": "location",
      "label": "location",
      "tsType": "\"top\" | \"bottom\" | \"bottom-right\" | \"top-left\" | \"top-right\" | \"top-center\" | \"bottom-left\" | \"bottom-center\" | undefined",
