      "defaultValue": 5,
      "hasFactoryDefault": false,
      "control": "number",
      "description": "Maximum number of items rendered concurrently. When `notify()`\npushes a new item past `max`, the oldest item in the stack is\nevicted FIFO (its `onDismiss` callback still fires).",
      "source": "types"
    },
