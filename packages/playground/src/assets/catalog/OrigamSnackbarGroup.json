      "options": [
        "top",
        "bottom",
        "bottom-right",
        "top-left",
        "top-right",
        "top-center",
        "bottom-left",
        "bottom-center"
      ],
      "control": "select",
      "description": "Anchor location on the viewport. Drives both the absolute\npositioning (top/bottom + left/right/center pinning) and the\n`direction` default.",
      "source": "types"
    },
    {
