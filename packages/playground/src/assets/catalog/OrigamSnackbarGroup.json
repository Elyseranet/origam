      "required": false,
      "defaultValue": 5000,
      "hasFactoryDefault": false,
      "control": "number",
      "description": "Default auto-dismiss timeout (ms) applied to items that do not\nsupply their own `duration`. Pass `0` to make all items sticky\nby default. Registered into the shared stack store on mount (and\nkept in sync reactively), so it applies to `notify()` calls from\nANY `useSnackbarGroup({ id })` instance targeting this stack —\nnot only calls that repeat `defaultDuration` as a composable\noption.",
      "source": "types"
    },
