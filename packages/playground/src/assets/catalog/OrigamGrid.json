      "name": "columns",
      "label": "columns",
      "tsType": "TGridTracks | undefined",
      "runtimeType": [
        "Number",
        "String",
        "Array"
      ],
      "required": false,
      "defaultValue": "auto",
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Track template for the inline axis (`grid-template-columns`).\n\n- `number` (e.g. `12`) — sugar for `repeat(N, 1fr)`.\n- `string` (e.g. `'1fr 2fr 1fr'` or `'repeat(auto-fill, minmax(200px, 1fr))'`)\n  — passed verbatim.\n- `string[]` (e.g. `['200px', '1fr', '200px']`) — joined with single space.",
      "source": "types"
    },
    {
      "name": "rows",
      "label": "rows",
      "tsType": "TGridTracks | undefined",
      "runtimeType": [
        "Number",
        "String",
        "Array"
      ],
      "required": false,
      "defaultValue": "auto",
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Track template for the block axis (`grid-template-rows`).\nSame accepted shapes as `columns`.",
      "source": "types"
    },
    {
      "name": "gap",
      "label": "gap",
      "tsType": "string | number | undefined",
      "runtimeType": null,
      "required": false,
      "defaultValue": "md",
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Both-axis gap. Accepts:\n\n- one of the size tokens `'xs' | 'sm' | 'md' | 'lg' | 'xl'`\n  (resolved to `var(--origam-grid---gap-{token})`, declared in\n  `assets/css/tokens/light.css` / `dark.css`).\n- any CSS length string (`'24px'`, `'1rem'`, `'1rem 2rem'`).\n- a plain `number` interpreted as pixels.\n\n`columnGap` / `rowGap` take precedence on their respective axis.",
      "source": "types"
    },
    {
      "name": "columnGap",
      "label": "columnGap",
      "tsType": "string | number | undefined",
      "runtimeType": null,
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Inline-axis-only gap override. Same accepted shapes as `gap`.",
      "source": "types"
    },
    {
      "name": "rowGap",
      "label": "rowGap",
      "tsType": "string | number | undefined",
      "runtimeType": null,
      "required": false,
      "hasFactoryDefault": false,
      "control": "text",
      "description": "Block-axis-only gap override. Same accepted shapes as `gap`.",
      "source": "types"
