{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@origam": ["./packages/ds/src"],
      "@origam/*": ["./packages/ds/src/*"],
      "@playground": ["./packages/playground/src"],
      "@playground/*": ["./packages/playground/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist",
    "scripts"
  ]
}
