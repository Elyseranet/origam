{
  "name": "@origam/playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Embeddable playground component for the origam design system — metadata chain, scene model and component registry. Private, never published: the only npm publish in this monorepo is packages/ds.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./composables": "./src/composables/index.ts",
    "./consts": "./src/consts/index.ts",
    "./enums": "./src/enums/index.ts",
    "./interfaces": "./src/interfaces/index.ts",
    "./types": "./src/types/index.ts",
    "./utils": "./src/utils/index.ts",
    "./catalog": "./src/utils/Commons/catalog.util.ts"
  },
  "scripts": {
    "meta:runtime": "node scripts/extract-runtime-metadata.mjs",
    "meta:unions": "node scripts/extract-literal-unions.mjs",
    "meta:aliases": "node scripts/resolve-type-aliases.mjs",
    "meta:report": "node scripts/report-metadata-coverage.mjs",
    "meta:catalog": "node scripts/generate-catalog.mjs",
    "meta:catalog:check": "node scripts/generate-catalog.mjs --check",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "dev": "vite --config vite.host.config.ts"
  },
  "dependencies": {
    "origam": "workspace:*",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue-component-meta": "3.3.6",
    "vue-tsc": "^3.3.6"
  }
}
