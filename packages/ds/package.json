{
  "name": "origam",
  "version": "2.16.0",
  "type": "module",
  "description": "origam — a Vue 3 design system with multi-theme design tokens, CSS-first components and TypeScript types.",
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "components",
    "ui",
    "ui-library",
    "design-tokens",
    "typescript",
    "composition-api",
    "scss",
    "css-variables",
    "theming",
    "dark-mode",
    "a11y"
  ],
  "license": "MIT",
  "author": "Prioul Arnaud",
  "homepage": "https://github.com/Elyseranet/origam#readme",
  "funding": {
    "type": "custom",
    "url": "https://www.paypal.com/donate/?hosted_button_id=EQFUQ2JV95YGQ"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elyseranet/origam.git"
  },
  "bugs": {
    "url": "https://github.com/Elyseranet/origam/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.vue"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "scss": "./dist/src/assets/scss/main.scss",
      "style": "./dist/src/assets/css/main.css",
      "default": "./dist/src/origam.js"
    },
    "./styles": {
      "scss": "./dist/src/assets/scss/main.scss",
      "style": "./dist/src/assets/css/main.css",
      "import": "./dist/src/assets/css/main.css",
      "require": "./dist/src/assets/css/main.css",
      "default": "./dist/src/assets/css/main.css"
    },
    "./tokens/css": "./dist/src/assets/css/tokens/primitive.css",
    "./tokens/css/primitive": "./dist/src/assets/css/tokens/primitive.css",
    "./tokens/css/light": "./dist/src/assets/css/tokens/light.css",
    "./tokens/css/dark": "./dist/src/assets/css/tokens/dark.css",
    "./tokens/css/utilities": "./dist/src/assets/css/tokens/origam-utilities.css",
    "./tokens/scss": "./dist/src/assets/scss/tokens/_primitive.scss",
    "./tokens/scss/primitive": "./dist/src/assets/scss/tokens/_primitive.scss",
    "./tokens/scss/light": "./dist/src/assets/scss/tokens/_light.scss",
    "./tokens/scss/dark": "./dist/src/assets/scss/tokens/_dark.scss",
    "./tokens/scss/utilities": "./dist/src/assets/scss/tokens/_origam-utilities.scss",
    "./tokens/types": "./dist/src/types/tokens.type.d.ts",
    "./origam": "./dist/src/origam.js",
    "./nuxt": {
      "types": "./dist/src/nuxt/module.d.ts",
      "import": "./dist/src/nuxt/module.js",
      "require": "./dist/src/nuxt/module.cjs",
      "default": "./dist/src/nuxt/module.js"
    },
    "./components": "./dist/src/components/index.js",
    "./components/*": "./dist/src/components/*/index.js",
    "./composables": "./dist/src/composables/index.js",
    "./themes": "./dist/src/themes/index.js",
    "./directives": "./dist/src/directives/index.js",
    "./enums": "./dist/src/enums/index.js",
    "./consts": "./dist/src/consts/index.js",
    "./types": "./dist/src/types/index.d.ts",
    "./interfaces": "./dist/src/interfaces/index.d.ts",
    "./services": "./dist/src/services/index.js",
    "./utils": "./dist/src/utils/index.js",
    "./*": "./dist/src/*"
  },
  "files": [
    "dist/src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm run styles:build && unbuild",
    "lib:build": "pnpm run build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "type-check:canary": "node scripts/nounusedlocals-canary.mjs",
    "styles:build": "sass src/assets/scss/main.scss src/assets/css/main.css --no-source-map --style=compressed",
    "guards": "node scripts/guards/run-all.mjs",
    "guards:declarations": "node scripts/guards/no-declarations-in-vue.mjs",
    "guards:variant-css": "node scripts/guards/no-variant-css.mjs",
    "guards:instance-types": "node scripts/guards/instance-types.mjs",
    "guards:naming": "node scripts/guards/file-naming.mjs",
    "guards:unconsumed-props": "node scripts/guards/unconsumed-props.mjs",
    "guards:emits-completeness": "node scripts/guards/emits-completeness.mjs",
    "guards:no-usedefaults": "node scripts/guards/no-usedefaults-in-components.mjs",
    "guards:token-var-channels": "node scripts/guards/token-var-channels.mjs",
    "guards:dead-handlers": "node scripts/guards/dead-handlers.mjs",
    "guards:id-forwarding": "node scripts/guards/id-forwarding.mjs",
    "guards:unemitted-declarations": "node scripts/guards/unemitted-declarations.mjs",
    "prepublishOnly": "pnpm run build",
    "prepack": "node -e \"require('fs').copyFileSync('../../CHANGELOG.md','CHANGELOG.md')\"",
    "guards:composables-doc": "node scripts/guards/composables-doc-sync.mjs",
    "docs:composables": "node scripts/analysis/gen-composables-doc.mjs --write"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "qrcode-generator": "^2.0.4"
  },
  "peerDependencies": {
    "shiki": "^4.3.1",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.5.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    },
    "vue-i18n": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^4.5.1",
    "@nuxt/schema": "^4.5.1",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "sass": "^1.102.0",
    "ts-transformer-keys": "^0.4.4",
    "typescript": "^6.0.3",
    "unbuild": "^3.5.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vue": "3.5.39",
    "vue-router": "^4.6.4",
    "vue-sfc-transformer": "^0.1.16",
    "vue-tsc": "^3.3.6"
  }
}
