# VRT baselines are ONLY trustworthy when captured in the pinned Linux
# container documented in packages/tests/vrt/VRT.md. Playwright's default
# snapshot naming embeds {platform}, so a baseline captured natively on a
# contributor's machine lands in a *-darwin.png / *-win32.png file distinct
# from the committed *-linux.png ones. Ignore those so an accidental native
# `--update-snapshots` run can never be committed by mistake.
packages/tests/vrt/**/*-darwin.png
packages/tests/vrt/**/*-win32.png

# Debug files
*.debug*


**/*/maquettes/
**/*/wireframes/

# TypeScript / tsc build artefacts — never track
# These are emitted by `tsc --emitDeclarationOnly` or by the IDE's
# Volar TS plugin. The repo authors only `.ts` / `.vue` / `.scss` in
# `src/`; any sibling `.js` / `.d.ts` / `.vue.js` is a build artefact.
*.tsbuildinfo
*.vue.js
src/**/*.js
src/components/**/*.d.ts
src/composables/**/*.d.ts
src/consts/**/*.d.ts
src/directives/**/*.d.ts
src/enums/**/*.d.ts
src/interfaces/**/*.d.ts
src/layouts/**/*.d.ts
src/types/**/*.d.ts
src/utils/**/*.d.ts
src/services/**/*.d.ts
src/stores/**/*.d.ts
src/assets/**/*.d.ts
src/factories/**/*.d.ts
src/icons/**/*.d.ts
src/locales/**/*.d.ts
src/plugins/**/*.d.ts
vite.config.js
vite.config.d.ts
docs/tsconfig.tsbuildinfo
origam-*.tgz

# Multi-PM support — only pnpm-lock.yaml is committed as the source of
# truth. Contributors can install via npm or yarn, but their generated
# lockfiles stay local to avoid the 3-way lockfile-drift problem.
package-lock.json
yarn.lock
.yarn/
.pnp.*

# Test coverage output (generated; consumed by SonarQube in CI)
coverage/
# design-sync (artefacts régénérés — la config/notes/scripts dans .design-sync/ SONT committés)
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Copie generee au packaging (prepack) — la source est le CHANGELOG.md racine
packages/ds/CHANGELOG.md

# Secrets locaux — ne JAMAIS versionner (le depot est public)
.env.local
.env.*.local
*.token

# Fichiers d environnement — jamais suivis (cf. politique globale)
.env
