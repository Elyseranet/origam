; ⛔ NE JAMAIS lancer `npm install` / `yarn install` dans ce dépôt.
;
; Le gestionnaire est pnpm, en disposition ISOLÉE : chaque entrée de
; `node_modules/` est un lien vers `node_modules/.pnpm/`. npm, lui, écrit de
; vrais dossiers — et pnpm ne les supprime pas, il pose ses liens À CÔTÉ.
; Les deux arbres cohabitent alors sans que rien ne le signale.
;
; Ce qu'il en coûte, mesuré (issue #382) : un `npm install` lancé à la racine
; le 17 mai y a laissé 676 vrais dossiers, dont `playwright`. Deux copies
; physiques de la MÊME version 1.59.1 se sont retrouvées installées ; Node
; indexant son cache de modules sur le realpath, cela fait deux registres
; `test.describe` distincts, donc un runner qui refuse tout spec lancé via le
; mauvais binaire. Le message d'erreur accusait « two different versions of
; @playwright/test » alors que le lockfile et `pnpm ls` étaient unanimes sur
; une seule version : ce que Node distingue n'est pas le numéro, c'est le
; chemin réel.
;
; Le garde `pnpm-tree-integrity` (packages/ds/scripts/guards/) rougit
; désormais dès qu'un vrai dossier réapparaît. Correctif si ça arrive :
;   rm -rf <ce node_modules> && pnpm install --frozen-lockfile
;
; histoire@1.0.0-alpha.2 declares a peer dep on vite ^6, but origam runs
; on vite ^7 — they're functionally compatible, the alpha just hasn't
; been re-published. `legacy-peer-deps=true` évite d'avoir à répéter
; `--legacy-peer-deps`. Ce réglage est un vestige de l'époque npm et NE VAUT
; PAS invitation à relancer npm — pnpm lit `auto-install-peers` plus bas.
;
; Drop this file once histoire ships a vite-7-compatible release.
legacy-peer-deps=true

; Strict engines off — node 22 is required (.nvmrc) but we don't want
; npm to refuse to install for a contributor running 20 (node 20+ has
; everything except the @vitejs/plugin-vue crypto.hash usage we already
; document in CLAUDE.md).
engine-strict=false

; pnpm monorepo settings
auto-install-peers=true
strict-peer-dependencies=false

; CRITICAL: with `"origam": "*"` (npm/yarn-compatible), pnpm by default
; resolves to the latest version on the registry instead of the workspace
; package. This caused marketing to load origam@2.5.0 from npm instead
; of packages/ds/ (workspace), breaking the `./styles` export.
; `link-workspace-packages=deep` forces pnpm to prefer the workspace
; package whenever its version satisfies the range — including `*`.
; npm and yarn already prefer workspace packages by default, so this
; setting only matters for pnpm.
link-workspace-packages=deep
prefer-workspace-packages=true
